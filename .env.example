# 模型（OpenAI 兼容，chat completions）
MODEL_BASE_URL=http://127.0.0.1:23333/v1
MODEL_API_KEY=sk-xxx
MODEL_NAME=gpt-4o

# 引擎：deepagents | openai-agents（也可用 --engine 参数）
AGENT_ENGINE=deepagents

# 可选
GATEWAY_HOST=localhost
GATEWAY_PORT=6217
GATEWAY_CONFIG=gateway.json
GATEWAY_TURN_TIMEOUT=900
GATEWAY_QUESTION_TIMEOUT=120
GATEWAY_PERMISSION_MODE=auto
GATEWAY_ASK_USER=false
GATEWAY_SHELL_SANDBOX=on
# MODEL_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
GATEWAY_MAX_STEPS=50
GATEWAY_LOG_LEVEL=INFO
